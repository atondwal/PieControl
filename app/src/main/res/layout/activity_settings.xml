<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Appearance -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/color_bg_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Slice color"
                android:textSize="14sp" />
            <View
                android:id="@+id/color_bg_preview"
                android:layout_width="48dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/color_highlight_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Highlight color"
                android:textSize="14sp" />
            <View
                android:id="@+id/color_highlight_preview"
                android:layout_width="48dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/color_stroke_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stroke color"
                android:textSize="14sp" />
            <View
                android:id="@+id/color_stroke_preview"
                android:layout_width="48dp"
                android:layout_height="32dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/icon_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Icon size: 36dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/icon_size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="48"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/stroke_width_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stroke width: 1.5dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/stroke_width_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:layout_marginBottom="16dp" />

        <!-- Pie Geometry -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pie Geometry"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/ring_width_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ring width: 51dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/ring_width_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/inner_radius_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inner radius: 60dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/inner_radius_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="80"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/gap_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slice gap: 0\u00B0"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/gap_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/arc_span_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arc span: 180\u00B0"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/arc_span_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="270"
            android:layout_marginBottom="16dp" />

        <!-- Trigger Zone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger Zone"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/trigger_width_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Width: 20dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/trigger_width_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="45"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/trigger_height_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Height: 43%"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/trigger_height_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="90"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/trigger_pos_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Position: 44%"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/trigger_pos_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:layout_marginBottom="16dp" />

        <!-- Vibration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vibration"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/vibe_tick_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tick amplitude: 60"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/vibe_tick_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/vibe_select_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select amplitude: 120"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/vibe_select_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/vibe_tick_ms_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tick duration: 10ms"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/vibe_tick_ms_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="99"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/vibe_select_ms_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select duration: 20ms"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/vibe_select_ms_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="199" />

        <!-- Backup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Backup"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_export"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Export" />

            <Button
                android:id="@+id/btn_import"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Import" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
